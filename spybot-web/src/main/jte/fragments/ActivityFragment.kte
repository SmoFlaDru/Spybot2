@param activityChart: com.spybot.core.model.ActivityChartView
<div class="card h-100" id="activity_fragment">
    <div class="card-header d-flex justify-content-between">
        <h3 class="card-title my-2">Recent activity</h3>
        <div class="lh-1">
            <div class="dropdown" hx-target:inherited="#activity_fragment" hx-swap:inherited="outerHTML">
                <a class="dropdown-toggle text-secondary" href="#" data-bs-toggle="dropdown" aria-haspopup="true"
                   aria-expanded="false">${activityChart.activeOptionText}</a>
                <div class="dropdown-menu dropdown-zx-end dropdown-menu-arrow" style="">
                    @for(option in activityChart.options)
                        <button class="${if (option.active) "dropdown-item active" else "dropdown-item"}" hx-get="/activity_fragment?timespan=${option.value}">${option.text}</button>
                    @endfor
                </div>
            </div>
        </div>
    </div>
    <div class="card-body ps-2">
        <div id="chart-mentions" class="h-100"></div>
    </div>
    <script>
        var renderActivityChart = () => {
            const days = [
                @for(entry in activityChart.points) new Date('$unsafe{entry.date.toString()}T00:00:00Z'), @endfor
            ]
            const monthNames = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec']
            const labels = days.map(d => String(d.getUTCDate()).padStart(2, '0') + ' ' + monthNames[d.getUTCMonth()])
            // About 10 labels at most: every day on the 7-day view, every nth day on longer ranges,
            // counted back from the latest day so that one is always labelled.
            const labelStep = Math.ceil(days.length / 10)
            window.ApexCharts && (new ApexCharts(document.getElementById('chart-mentions'), {
                chart: {
                    height: "100%",
                    type: "bar",
                    fontFamily: 'inherit',
                    parentHeightOffset: 0,
                    toolbar: {
                        show: false,
                    },
                    zoom: {enabled: false},
                    animations: {
                        enabled: true,
                        easing: 'easein',
                        speed: 1000,
                        animateGradually: {
                            enabled: true,
                            delay: 150
                        },
                        dynamicAnimation: {
                            enabled: true,
                            speed: 550
                        }
                    },
                    stacked: true,
                },
                plotOptions: {
                    bar: {
                        columnWidth: '50%',
                        borderRadius: 2,
                        borderRadiusApplication: "end",
                    }
                },
                dataLabels: {
                    enabled: false,
                },
                fill: {
                    opacity: 1,
                },
                series: [{
                    name: "Talking",
                    data: [$unsafe{activityChart.points.joinToString(", ") { it.activeHours.toString() }}]
                }, {
                    name: "Idling",
                    data: [$unsafe{activityChart.points.joinToString(", ") { it.afkHours.toString() }}]
                }],
                tooltip: {
                    theme: 'dark',
                    x: {
                        formatter: (value, {dataPointIndex}) => days[dataPointIndex].toLocaleDateString('en-GB', {
                            day: '2-digit',
                            month: 'long',
                            timeZone: 'UTC',
                        }),
                    },
                    shared: true,
                    intersect: false,
                    followCursor: false,
                },
                grid: {
                    padding: {
                        top: -20,
                        right: 0,
                        left: 4,
                        bottom: -4
                    },
                    strokeDashArray: 4,
                    xaxis: {
                        lines: {
                            show: true
                        }
                    },
                },
                xaxis: {
                    labels: {
                        padding: 0,
                        rotate: 0,
                        formatter: (value) => (days.length - 1 - labels.indexOf(value)) % labelStep === 0 ? value : '',
                    },
                    // A tick under every bar, so the days without a label can still be told apart.
                    axisTicks: {
                        show: true,
                    },
                    tooltip: {
                        enabled: false
                    },
                    axisBorder: {
                        show: false,
                    },
                    // A category axis labels every bar. The series has an entry for every day of the
                    // range (days without activity are zero), so nothing is misplaced in time.
                    type: 'category',
                },
                yaxis: {
                    title: {
                        text: "Cumulative hours",
                        offsetX: 0,
                        style: {fontWeight: 500},
                    },
                    labels: {
                        padding: 20,
                        formatter: (value) => {
                            return value.toFixed(0)
                        }
                    }
                },
                labels: labels,
                colors: [tabler.tabler.getColor("primary"), tabler.tabler.getColor("red", 0.8), tabler.tabler.getColor("green", 0.8)],
                legend: {
                    show: false,
                },
            })).render();
        }

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", renderActivityChart);
        } else {
            // Swapped in by htmx (hx-swap="outerHTML"): this script runs after the new card is
            // inserted but before the old one is removed, so rendering now would size the 100%
            // height chart against a column that momentarily holds both cards - and the chart
            // would grow with every timespan change. Defer past the swap so the old card is gone.
            setTimeout(renderActivityChart, 0);
        }
    </script>
</div>
