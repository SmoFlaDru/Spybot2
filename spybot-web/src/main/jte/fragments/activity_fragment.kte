@param activityChart: com.spybot.core.model.ActivityChartView
<div class="card chart-card h-100" id="activity_fragment">
    <div class="card-header d-flex justify-content-between">
        <h3 class="card-title my-2">Recent activity</h3>
        <div class="lh-1">
            <div class="dropdown" hx-target="#activity_fragment" hx-swap="outerHTML">
                <a class="dropdown-toggle text-secondary" href="#" data-bs-toggle="dropdown" aria-haspopup="true"
                   aria-expanded="false">${activityChart.activeOptionText}</a>
                <div class="dropdown-menu dropdown-zx-end dropdown-menu-arrow" style="">
                    @for(option in activityChart.options)
                        <button class="${if (option.active) "dropdown-item active" else "dropdown-item"}" hx-get="/activity_fragment?timespan=${option.value}">${option.text}</button>
                    @endfor
                </div>
            </div>
        </div>
    </div>
    <div class="card-body ps-2">
        <div id="chart-mentions" class="h-100"></div>
    </div>
    <script>
        var activityApex = null;
        var renderActivityChart = () => {
            const el = document.getElementById('chart-mentions');
            if (!el) return;
            // The label style follows the pixels available per bar (not the viewport), so it also
            // works in a narrow grid column on a wide screen. Category axis keeps each label
            // centered under its bar.
            const pointCount = ${activityChart.points.size};
            const slot = (el.clientWidth - 60) / pointCount;
            const labelMode = slot >= 52 ? 'weekday' : slot >= 24 ? 'stacked' : 'thinned';
            const tickAmount = labelMode === 'thinned' ? Math.max(2, Math.floor((el.clientWidth - 60) / 75)) : undefined;
            const modeKey = labelMode + ':' + tickAmount;
            if (activityApex && activityApex.modeKey === modeKey) return;
            if (activityApex) activityApex.destroy();
            const parseDay = (value) => new Date(String(value).length <= 10 ? value + 'T00:00:00Z' : value);
            activityApex = window.ApexCharts && (new ApexCharts(el, {
                chart: {
                    height: "100%",
                    type: "bar",
                    fontFamily: 'inherit',
                    parentHeightOffset: 0,
                    toolbar: {
                        show: false,
                    },
                    zoom: {enabled: false},
                    animations: {
                        enabled: true,
                        easing: 'easein',
                        speed: 1000,
                        animateGradually: {
                            enabled: true,
                            delay: 150
                        },
                        dynamicAnimation: {
                            enabled: true,
                            speed: 550
                        }
                    },
                    stacked: true,
                },
                plotOptions: {
                    bar: {
                        columnWidth: '50%',
                        borderRadius: 2,
                        borderRadiusApplication: "end",
                    }
                },
                dataLabels: {
                    enabled: false,
                },
                fill: {
                    opacity: 1,
                },
                series: [{
                    name: "Talking",
                    data: [$unsafe{activityChart.points.joinToString(", ") { it.activeHours.toString() }}]
                }, {
                    name: "Idling",
                    data: [$unsafe{activityChart.points.joinToString(", ") { it.afkHours.toString() }}]
                }],
                tooltip: {
                    theme: 'dark',
                    x: {
                        formatter: (value, opts) => parseDay(opts.w.globals.labels[opts.dataPointIndex]).toLocaleDateString(undefined, {day: '2-digit', month: 'long', timeZone: 'UTC'}),
                    },
                    shared: true,
                    intersect: false,
                    followCursor: false,
                },
                grid: {
                    padding: {
                        top: -20,
                        right: 0,
                        left: 4,
                        bottom: -4
                    },
                    strokeDashArray: 4,
                    xaxis: {
                        lines: {
                            show: true
                        }
                    },
                },
                xaxis: {
                    labels: {
                        padding: 0,
                        rotate: 0,
                        hideOverlappingLabels: true,
                        formatter: (value) => {
                            const d = parseDay(value);
                            if (labelMode === 'thinned') {
                                return d.toLocaleDateString(undefined, {day: 'numeric', month: 'short', timeZone: 'UTC'});
                            }
                            const weekday = d.toLocaleDateString(undefined, {weekday: labelMode === 'stacked' ? 'narrow' : 'short', timeZone: 'UTC'});
                            return labelMode === 'stacked' ? [weekday, String(d.getUTCDate())] : weekday + " " + d.getUTCDate();
                        },
                    },
                    tooltip: {
                        enabled: false
                    },
                    axisBorder: {
                        show: false,
                    },
                    axisTicks: {
                        show: false,
                    },
                    type: 'category',
                    tickAmount: tickAmount,
                },
                yaxis: {
                    title: {
                        text: "Cumulative hours",
                        offsetX: 0,
                        style: {fontWeight: 500},
                    },
                    labels: {
                        padding: 20,
                        formatter: (value) => {
                            return value.toFixed(0)
                        }
                    }
                },
                labels: [
                    @for(entry in activityChart.points) '$unsafe{entry.date.toString()}', @endfor
                ],
                colors: [tabler.tabler.getColor("primary"), tabler.tabler.getColor("red", 0.8), tabler.tabler.getColor("green", 0.8)],
                legend: {
                    show: false,
                },
            }));
            if (activityApex) {
                activityApex.modeKey = modeKey;
                activityApex.render();
            }
        }

        var watchActivityChartSize = () => {
            const el = document.getElementById('chart-mentions');
            if (!el || !window.ResizeObserver) return;
            let timer = null;
            const observer = new ResizeObserver(() => {
                clearTimeout(timer);
                timer = setTimeout(() => {
                    if (!el.isConnected) return observer.disconnect();
                    renderActivityChart();
                }, 150);
            });
            observer.observe(el);
        };

        if (document.readyState === "loading") {
            document.addEventListener("DOMContentLoaded", () => { renderActivityChart(); watchActivityChartSize(); });
        } else {
            renderActivityChart();
            watchActivityChartSize();
        }
    </script>
</div>
