@param steamIds: java.util.List<com.spybot.core.model.SteamIdView>
<div class="card">
    <div class="card-header">Linked Steam Accounts</div>
    <div class="table-responsive">
        <table class="table table-vcenter card-table">
            <thead>
            <tr>
                <th>Account Name</th>
                <th>Steam ID</th>
                <th class="w-1"></th>
            </tr>
            </thead>
            <tbody hx-confirm="Are you sure you want to delete the passkey?" hx-target="closest tr"
                   hx-swap="outerHTML swap:1s">
            @for(sid in steamIds)
                <tr>
                    <td>${sid.accountName ?: ""}</td>
                    <td class="text-secondary">${sid.steamId}</td>
                    <td><a href="#" hx-delete="/profile/steamid/${sid.id}">Delete</a></td>
                </tr>
            @endfor
            </tbody>
        </table>
    </div>
    <div class="card-body">
        <button class="btn btn-primary" hx-get="/profile/steamid" hx-target="#dialog">Link new Steam Account</button>
    </div>
</div>
