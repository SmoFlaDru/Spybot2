@param entry: com.spybot.web.service.ChangelogEntry
<div class="row align-items-center mb-2">
    <div class="col-auto">
        @if(entry.isCommitted && entry.tags.isEmpty())
            <span class="h3 mb-0 commit-hash">#${entry.title}</span>
        @else
            <span class="h3 mb-0">${entry.title}</span>
        @endif
    </div>
    <div class="col text-secondary">
        @if(entry.isCommitted)
            <relative-time datetime="${entry.committedAt.toString()}">${entry.committedAt.toString()}</relative-time>
            !{val hashShownAsTitle = entry.tags.isEmpty()}
            @if(!hashShownAsTitle)
                &middot; <code class="commit-hash">#${entry.commit}</code>
            @endif
            @for(tag in entry.tags.drop(1))
                <span class="badge bg-blue-lt ms-1">${tag}</span>
            @endfor
        @else
            Uncommitted changes in this working tree
        @endif
    </div>
</div>
<ul class="mb-0">
    @for(feature in entry.bullets)
        <li>${feature}</li>
    @endfor
</ul>
