@param loggedInUser: com.spybot.core.model.MergedUserView
@param csrf: org.springframework.security.web.csrf.CsrfToken?
@param commitHash: String? = null
@param buildTime: java.time.Instant? = null
@param query: String
@param users: java.util.List<com.spybot.core.model.AdminMergedUserRow>
@template.layout.base(title = "Merged users", loggedInUser = loggedInUser, csrf = csrf, commitHash = commitHash, buildTime = buildTime, activePage = "admin", content = @`
    <div class="row row-cards justify-content-md-center">
        <div class="col-md-10">
            <div class="card">
                <div class="card-header row g-0">
                    <div class="col"><h3 class="card-title">Merged users</h3></div>
                    <div class="col-auto">
                        <form method="get" class="d-flex">
                            <input type="text" class="form-control" name="q" placeholder="Search by name" value="${query}">
                        </form>
                    </div>
                </div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                        <tr>
                            <th>ID</th>
                            <th>Name</th>
                            <th>TS users</th>
                            <th>Admin</th>
                            <th>Obsolete</th>
                            <th>Last login</th>
                        </tr>
                        </thead>
                        <tbody>
                        @for(user in users)
                            <tr>
                                <td class="text-secondary">${user.id}</td>
                                <td><a href="/u/${user.id}">${user.name}</a></td>
                                <td class="text-secondary">${user.tsUserCount}</td>
                                <td>
                                    @if(user.isSuperuser)
                                        <span class="badge bg-primary">Admin</span>
                                    @endif
                                </td>
                                <td>
                                    @if(user.obsolete)
                                        <span class="badge bg-secondary">Obsolete</span>
                                    @endif
                                </td>
                                <td class="text-secondary">${user.lastLogin?.toString() ?: ""}</td>
                            </tr>
                        @endfor
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
`)
