@param loggedInUser: com.spybot.core.model.MergedUserView
@param csrf: org.springframework.security.web.csrf.CsrfToken?
@param commitHash: String? = null
@param buildTime: java.time.Instant? = null
@param form: com.spybot.web.controller.AdminController.NewsEventForm
@param editMode: Boolean
@param eventId: Long?
@param errorMessage: String? = null
@template.layout.base(title = "News event", loggedInUser = loggedInUser, csrf = csrf, commitHash = commitHash, buildTime = buildTime, activePage = "admin", content = @`
    <div class="row row-cards justify-content-md-center">
        <div class="col-md-8">
            @if(errorMessage != null)
                <div class="alert alert-danger">${errorMessage}</div>
            @endif
            <div class="card">
                <div class="card-header">
                    <h3 class="card-title">${if (editMode) "Edit news event" else "New news event"}</h3>
                </div>
                <form method="post" action="${if (editMode) "/admin/news-events/" + eventId else "/admin/news-events"}">
                    <input type="hidden" name="${if (csrf != null) csrf.parameterName else "_csrf"}" value="${if (csrf != null) csrf.token else ""}">
                    <div class="card-body">
                        <div class="mb-3">
                            <label class="form-label">Text</label>
                            <textarea class="form-control" name="text" rows="4" required>${form.text}</textarea>
                        </div>
                        <div class="mb-3">
                            <label class="form-label">Website link</label>
                            <input type="text" class="form-control" name="websiteLink" value="${form.websiteLink ?: ""}">
                        </div>
                    </div>
                    <div class="card-footer text-end">
                        <a href="/admin/news-events" class="btn">Cancel</a>
                        <button class="btn btn-primary" type="submit">${if (editMode) "Save" else "Create"}</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
`)
