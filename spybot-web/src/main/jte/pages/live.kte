@param loggedInUser: com.spybot.core.model.MergedUserView?
@param channels: java.util.List<com.spybot.core.model.ChannelView>
@param clients: java.util.List<com.spybot.core.model.LiveClientView>
@param csrf: org.springframework.security.web.csrf.CsrfToken?
@param commitHash: String? = null
@param buildTime: java.time.Instant? = null
@template.layout.base(title = "Live", loggedInUser = loggedInUser, csrf = csrf, commitHash = commitHash, buildTime = buildTime, activePage = "home", content = @`
    <style>
        table {
            margin-left: auto;
            margin-right: auto;
            border: 1px solid black;
            border-collapse: collapse;
        }
        table tr {
            border-bottom: 1px solid black;
        }
    </style>

    @if(!channels.isEmpty())
        <table>
            <tr><td><b>TS3</b></td></tr>
            @for(channel in channels)
                @if(channel.name != null && !channel.name!!.contains("spacer"))
                    <tr><td>${channel.name}</td></tr>
                    @for(client in clients)
                        @if(channel.id == client.channelId)
                            <tr><td style="padding-left:15px;">-->${client.name ?: ""}</td></tr>
                        @endif
                    @endfor
                @endif
            @endfor
        </table>
    @else
        cringe
    @endif
`)
