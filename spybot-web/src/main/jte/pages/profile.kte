@param loggedInUser: com.spybot.core.model.MergedUserView
@param passkeys: java.util.List<com.spybot.core.model.PasskeyView>
@param steamIds: java.util.List<com.spybot.core.model.SteamIdView>
@param csrf: org.springframework.security.web.csrf.CsrfToken?
@param commitHash: String? = null
@param buildTime: java.time.Instant? = null
@template.layout.base(title = "Profile", loggedInUser = loggedInUser, csrf = csrf, commitHash = commitHash, buildTime = buildTime, activePage = "profile", content = @`
    <div class="row row-cards justify-content-md-center">
        <div class="col-md-8">
            <div class="card">
                <div class="card-header row g-0">
                    <h3 class="card-title">Logged in as ${loggedInUser.name}</h3>
                </div>
            </div>
        </div>
        <div class="col-md-8">
            <div class="card">
                <div class="card-header">Passkeys</div>
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                        <tr>
                            <th>Name</th>
                            <th>Platform</th>
                            <th>Last used</th>
                            <th>Created</th>
                            <th class="w-1"></th>
                        </tr>
                        </thead>
                        <tbody hx-confirm="Are you sure you want to delete the passkey?" hx-target="closest tr"
                               hx-swap="outerHTML swap:1s">
                        @for(key in passkeys)
                            <tr>
                                <td>${key.name}</td>
                                <td class="text-secondary">${key.platform}</td>
                                <td class="text-secondary">${key.lastUsed?.toString() ?: ""}</td>
                                <td class="text-secondary">${key.addedOn?.toString() ?: ""}</td>
                                <td><a href="#" hx-delete="/profile/passkey/${key.id}">Delete</a></td>
                            </tr>
                        @endfor
                        </tbody>
                    </table>
                </div>
                <div class="card-body">
                    <button id="addPasskeyButton" class="btn btn-primary">Add a new passkey</button>
                </div>
            </div>
        </div>
        <div class="col-md-8" hx-trigger="steamids_changed from:body" hx-get="/profile/steamid/all" hx-target="this">
            @template.fragments.profile_steamids(steamIds = steamIds)
        </div>
    </div>

    <script>
        window.addEventListener("load", () => {
            document.querySelector('#addPasskeyButton').addEventListener("click", async () => {
                await passkeys.create();
                window.location.reload();
            });
        });
    </script>
`)
